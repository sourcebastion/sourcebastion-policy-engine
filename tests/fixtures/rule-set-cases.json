{
  "fixture_version": 1,
  "description": "Compiler/Cedar conformance slice; explicit-disable case only, no absent-configuration default.",
  "cases": [
    {
      "id": "all_blocking_rules_retained",
      "rules": [
        {"set_id":"lenient","rule_id":"limit","effect":"block","max_new":5},
        {"set_id":"strict","rule_id":"limit","effect":"block","max_new":2}
      ],
      "new_high": 6,
      "expected": "blocked",
      "blocked": ["lenient/limit","strict/limit"],
      "warnings": []
    },
    {
      "id": "all_warning_rules_retained",
      "rules": [
        {"set_id":"notice","rule_id":"limit","effect":"warn","max_new":5},
        {"set_id":"strict","rule_id":"limit","effect":"warn","max_new":2}
      ],
      "new_high": 6,
      "expected": "passed_with_warnings",
      "blocked": [],
      "warnings": ["notice/limit","strict/limit"]
    },
    {
      "id": "disabled_set_does_not_disable_other_block",
      "rules": [
        {"set_id":"disabled","rule_id":"limit","effect":"block","max_new":0,"set_enabled":false},
        {"set_id":"remaining","rule_id":"limit","effect":"block","max_new":2}
      ],
      "new_high": 3,
      "expected": "blocked",
      "blocked": ["remaining/limit"],
      "warnings": []
    },
    {
      "id": "unknown_explicitly_selected",
      "rules": [{"set_id":"classification","rule_id":"limit","effect":"block","max_new":0,"severities":["unknown"]}],
      "new_high": 0,
      "new_unknown": 1,
      "expected": "blocked",
      "blocked": ["classification/limit"],
      "warnings": []
    },
    {
      "id": "unknown_not_silently_added",
      "rules": [{"set_id":"legacy","rule_id":"limit","effect":"block","max_new":0,"severities":["critical","high"]}],
      "new_high": 0,
      "new_unknown": 1,
      "expected": "passed",
      "blocked": [],
      "warnings": []
    },
    {
      "id": "strictest_block",
      "rules": [
        {
          "set_id": "lenient",
          "rule_id": "limit",
          "effect": "block",
          "max_new": 5
        },
        {
          "set_id": "strict",
          "rule_id": "limit",
          "effect": "block",
          "max_new": 2
        }
      ],
      "new_high": 3,
      "expected": "blocked",
      "blocked": [
        "strict/limit"
      ],
      "warnings": []
    },
    {
