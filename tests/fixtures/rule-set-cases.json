          "effect": "block",
          "max_new": 5
        },
        {
          "set_id": "notice",
          "rule_id": "limit",
          "effect": "warn",
          "max_new": 0
        }
      ],
      "new_high": 3,
      "expected": "passed_with_warnings",
      "blocked": [],
      "warnings": [
        "notice/limit"
      ]
    },
    {
      "id": "block_retains_warning",
